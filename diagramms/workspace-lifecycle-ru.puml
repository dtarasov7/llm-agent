@startuml
title Coding Agent 1.2.0 — Жизненный цикл копии и перенос изменений
actor "Пользователь" as user
participant "REPL" as cli
participant "WorkspaceManager" as wm
database "Исходный проект" as original
database "Начальная база" as baseline
database "Копия агента" as copy
database "Закрытое состояние / резервные копии" as state
user -> cli : запуск с --workspace
cli -> wm : проверка последней задачи этого проекта
alt подходящая копия с неприменёнными правками и без --new-session
  wm -> state : проверка манифеста и указателя задачи
  wm -> copy : подключение сохранённой изменяемой копии
  wm --> user : RESUMED; файлы доступны для /apply
else новый сеанс
  wm -> original : чтение безопасного ограниченного дерева
  wm -> baseline : копирование и запись начальных сумм
  wm -> copy : создание независимой изменяемой копии
  wm -> state : сохранение манифеста сеанса
end
user -> cli : задача на естественном языке
cli -> copy : правки через Agent / ToolRegistry
user -> cli : /diff
cli -> copy : сравнение с исходными файлами задачи
copy --> user : различия текущей задачи
opt /diff --session
  cli -> wm : diff()
  wm -> baseline : чтение начального содержимого
  wm -> copy : чтение текущего содержимого
  wm --> user : различия относительно базы сеанса
end
user -> cli : /apply
cli -> wm : apply(confirm)
wm -> original : сравнение с последними применёнными суммами оригинала
alt внешний конфликт или удаление
  wm --> user : отказ до записи
else безопасные неприменённые файлы
  wm --> user : список неприменённых файлов и числа строк
  user --> wm : явное y / отказ по умолчанию
  alt подтверждено
    wm -> original : повторная проверка сумм оригинала
    wm -> state : копии оригинала + журнал переноса
    loop каждый неприменённый файл
      wm -> original : атомарная запись после проверки конфликтов файла
      wm -> state : обновление последней применённой суммы
    end
    wm --> user : применённые пути и каталог резервных копий
  else отклонено
    wm --> user : оригинал без изменений
  end
end
user -> cli : /revert
cli -> wm : revert()
wm -> baseline : чтение начального дерева сеанса
wm -> copy : подготовленная замена всей копии
wm --> user : оригинал не меняется; ранее применённые правки сохраняются
user -> cli : /discard
cli -> wm : discard(confirm)
wm --> user : подтверждение при неприменённых изменениях
wm -> state : удаление сеанса после требуемого подтверждения
cli --> user : выход после успешного удаления
@enduml
